cabal-version: 3.0
name: brain
version: 0.1.0.0
build-type: Simple

-- Clash inference core (synthesizable to VHDL/Verilog).
-- Build with: cabal build brain-clash
-- Synthesise with: clash --vhdl BrainClash.hs
library brain-clash
  exposed-modules:    BrainClash
  hs-source-dirs:     .
  default-language:   Haskell2010
  default-extensions:
    DataKinds
    NoImplicitPrelude
    TypeOperators
  ghc-options:
    -Wall
  build-depends:
      base                      >= 4.14 && < 5
    , clash-prelude             >= 1.6
    , ghc-typelits-natnormalise >= 0.7
    , ghc-typelits-extra        >= 0.4
    , ghc-typelits-knownnat     >= 0.7

executable brain
  main-is: brain.hs
  other-modules: LinAlg
  hs-source-dirs: .
  default-language: Haskell2010
  ghc-options: -Wall -O2
  build-depends:
      base >= 4.20 && < 5
    , random