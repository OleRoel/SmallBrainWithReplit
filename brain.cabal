cabal-version: 3.0
name:          brain
version:       0.1.0.0
build-type:    Simple
data-files:    BrainClash.template

-- ---------------------------------------------------------------------------
-- Shared training library
-- BrainTrain and LinAlg live here so each source file belongs to exactly
-- one component, which keeps GHCi and HLS happy.
-- ---------------------------------------------------------------------------

library
  exposed-modules:  BrainTrain, LinAlg
  hs-source-dirs:   src
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:
      base   >= 4.20 && < 5
    , random

-- ---------------------------------------------------------------------------
-- Clash synthesizable inference core
-- ---------------------------------------------------------------------------

library brain-clash
  exposed-modules:    BrainClash, SwitchBrain, SwitchLED, DE1SoC,
                      DE1SoCDiagnostic, DE25Nano, DE25NanoDiagnostic
  hs-source-dirs:     .
  default-language:   Haskell2010
  default-extensions:
    DataKinds
    NoImplicitPrelude
    TypeOperators
  ghc-options:        -Wall
  build-depends:
      base                      >= 4.14 && < 5
    , clash-prelude             >= 1.6
    , ghc-typelits-natnormalise >= 0.7
    , ghc-typelits-extra        >= 0.4
    , ghc-typelits-knownnat     >= 0.7

-- ---------------------------------------------------------------------------
-- Executables
-- ---------------------------------------------------------------------------

executable brain
  main-is:          brain.hs
  hs-source-dirs:   .
  default-language: Haskell2010
  ghc-options:      -Wall -O2
  build-depends:
      base  >= 4.20 && < 5
    , brain

executable train
  main-is:          Train.hs
  other-modules:    SwitchTraining, Paths_brain
  autogen-modules:  Paths_brain
  hs-source-dirs:   .
  default-language: Haskell2010
  ghc-options:      -Wall -O2
  build-depends:
      base   >= 4.20 && < 5
    , random
    , brain

executable train-mnist
  main-is:          TrainMNIST.hs
  hs-source-dirs:   .
  default-language: Haskell2010
  ghc-options:      -Wall -O2
  other-modules:    Paths_brain
  autogen-modules:  Paths_brain
  build-depends:
      base     >= 4.20 && < 5
    , brain
    , deepseq  >= 1.4
    , filepath >= 1.4
    , process  >= 1.6
    , random
    , time     >= 1.9

executable train-mnist-parallel
  main-is:          TrainMNISTParallel.hs
  hs-source-dirs:   .
  default-language: Haskell2010
  ghc-options:      -Wall -O2 -threaded
  other-modules:    Paths_brain
  autogen-modules:  Paths_brain
  build-depends:
      base     >= 4.20 && < 5
    , async    >= 2.2
    , brain
    , deepseq  >= 1.4
    , filepath >= 1.4
    , process  >= 1.6
    , random
    , time     >= 1.9

-- ---------------------------------------------------------------------------
-- Tests
-- ---------------------------------------------------------------------------

test-suite switch-led-tests
  type:             exitcode-stdio-1.0
  main-is:          SwitchLEDTests.hs
  hs-source-dirs:   tests
  default-language: Haskell2010
  ghc-options:      -Wall -O2
  build-depends:
      base           >= 4.20 && < 5
    , brain:brain-clash
    , clash-prelude  >= 1.6
